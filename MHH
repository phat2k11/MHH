	{ Title = "teddy kaitun", Callback = function() warn("(demo)") end },
})
for name, frame in pairs(tabs) do
	local button = createTab(name)
	button.MouseButton1Click:Connect(function()
		for _, f in pairs(tabs) do
			if typeof(f) == "Instance" then
				f.Visible = false
			end
		end
		frame.Visible = true
	end)
end
toggleButton.MouseButton1Click:Connect(function()
