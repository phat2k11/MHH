    local allowToggle = Instance.new("TextButton", frame)
    allowToggle.Size = UDim2.new(0,180,0,30)
    allowToggle.Position = UDim2.new(0,10,1,-40)
    allowToggle.BackgroundColor3 = Color3.fromRGB(35,35,35)
    allowToggle.Text = "Luôn cho phép lần sau: Không"
    allowToggle.Font = Enum.Font.Gotham
    allowToggle.TextSize = 14
    local always = false
    allowToggle.MouseButton1Click:Connect(function()
        always = not always
        allowToggle.Text = "Luôn cho phép lần sau: "..(always and "Có" or "Không")
    end)

    local btnAccept = Instance.new("TextButton", frame)
    btnAccept.Size = UDim2.new(0,100,0,30)
    btnAccept.Position = UDim2.new(1,-110,1,-40)
    btnAccept.BackgroundColor3 = Color3.fromRGB(0,150,120)
    btnAccept.Text = "Chấp nhận"
    btnAccept.Font = Enum.Font.Gotham
    btnAccept.TextSize = 14

    local btnCancel = Instance.new("TextButton", frame)
    btnCancel.Size = UDim2.new(0,100,0,30)
    btnCancel.Position = UDim2.new(1,-220,1,-40)
    btnCancel.BackgroundColor3 = Color3.fromRGB(120,30,30)
    btnCancel.Text = "Hủy"
    btnCancel.Font = Enum.Font.Gotham
    btnCancel.TextSize = 14

    local result = nil
    local con1, con2
    con1 = btnAccept.MouseButton1Click:Connect(function()
        result = true
        if always then player:SetAttribute("Grai_AlwaysAllow", true) end
        gui:Destroy()
    end)
    con2 = btnCancel.MouseButton1Click:Connect(function()
        result = false
        gui:Destroy()
    end)

    -- block until GUI destroyed or result set
    repeat task.wait() until not gui or result ~= nil
    return result == true
end

-- ====================
-- Fluent loader + Window creation (an toàn)
-- ====================
local Fluent = nil
local Window = nil

local function tryLoadFluent()
    local candidates = {
        "https://raw.githubusercontent.com/dawid-scripts/Fluent/main/main.lua",
        "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
    }
    for _, url in ipairs(candidates) do
        local body, err = safeHttpGet(url)
        if body then
            local fn, lerr = loadstring(body)
            if fn then
                local ok, res = pcall(fn)
                if ok then
                    -- some loaders return api, some set global
                    Fluent = res or _G.Fluent or Fluent
                    if Fluent and type(Fluent.CreateWindow) == "function" then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- ====================
-- Build UI using Fluent if có
-- ====================
local function buildUI()
    if not Fluent then
        notify("Fluent loader not available. UI menu sẽ không khởi tạo.", 4)
        return
    end

    Window = Fluent:CreateWindow({
        Title="Grai2",
        SubTitle="Tổng Hợp Script",
        TabWidth=157,
        Size=UDim2.fromOffset(560,360),
        Acrylic=true,
        Theme="Dark",
        MinimizeKey=Enum.KeyCode.End
    })

    local tabs = {}
    for _, tabConf in ipairs(HUB_CONFIG) do
        local t = Window:AddTab({ Title = tabConf.tab })
        tabs[tabConf.tab] = t
        for _, entry in ipairs(tabConf.entries) do
            if entry.enabled ~= false then
                -- create button
                t:AddButton({
                    Title = entry.title,
                    Description = entry.desc,
                    Callback = function()
                        -- if entry provides direct function action, run it (with pcall)
                        if type(entry.action) == "function" then
                            local ok, err = pcall(entry.action)
                            if not ok then
                                notify("Lỗi khi chạy action: "..tostring(err), 3)
                            end
                            return
                        end

                        -- require confirmation
                        local approved = confirmRun(entry.title, entry.url, entry.desc)
                        if not approved then
                            notify("Đã hủy tải: "..entry.title, 2)
                            return
                        end

                        notify("Đang tải: "..entry.title, 2)
                        local ok, err = safeLoadFromUrl(entry.url)
                        if ok then
                            notify("Đã chạy: "..entry.title, 3)
                        else
                            notify("Lỗi: "..tostring(err), 4)
                        end
                    end
                })
            end
        end
    end

    -- add a settings toggle inside the first tab for "Luôn cho phép" control
    local infoTab = Window.Tabs and Window.Tabs[1] or nil
   
