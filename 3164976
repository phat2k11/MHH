-- FruitModule
-- Module to describe fruits and abilities

local FruitModule = {}

-- Define fruit types
FruitModule.Fruits = {
    ["Flame"] = {
        Name = "Flame",
        Duration = 8, -- ability duration seconds
        Cooldown = 6,
        Description = "Short dash of fire that deals damage on touch",
    },
    ["Wave"] = {
        Name = "Wave",
        Duration = 6,
        Cooldown = 8,
        Description = "A forward shockwave that knocks back enemies",
