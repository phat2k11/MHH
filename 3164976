return FruitModule
-- FruitSpawner
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local FruitModule = require(ReplicatedStorage:WaitForChild("FruitModule"))
local FruitRemote = ReplicatedStorage:WaitForChild("FruitRemote")

-- Configuration
local SPAWN_INTERVAL = 20 -- seconds between spawns
local MAX_FRUITS = 6
local AREAS = Workspace:FindFirstChild("FruitSpawnAreas") -- optional folder with Parts to spawn on

-- Helper: pick random point in spawn area (or near origin)
local function getSpawnCFrame()
    if AREAS and #AREAS:GetChildren() > 0 then
        local area = AREAS:GetChildren()[math.random(1, #AREAS:GetChildren())]
        if area:IsA("BasePart") then
            local size = area.Size
            local rndX = (math.random()-0.5) * size.X
            local rndZ = (math.random()-0.5) * size.Z
            local pos = area.Position + Vector3.new(rndX, size.Y/2 + 1, rndZ)
            return CFrame.new(pos)
        end
    end
    -- fallback
    local pos = Vector3.new(math.random(-50,50), 5, math.random(-50,50))
    return CFrame.new(pos)
end

-- Create a fruit Model (simple)
local function createFruitModel(fruitType)
    local model = Instance.new("Model")
    model.Name = fruitType .. "Fruit"

    local part = Instance.new("Part")
    part.Name = "FruitPart"
    part.Size = Vector3.new(2,2,2)
    part.Shape = Enum.PartType.Ball
    part.Anchored = true
    part.CanCollide = false
    part.Parent = model

    -- simple visual
    local mesh = Instance.new("SpecialMesh", part)
    mesh.MeshType = Enum.MeshType.Sphere

    -- tag attribute
    model:SetAttribute("FruitType", fruitType)

    return model
end

-- Keep track of spawned fruits
local spawned = {}

local function spawnFruit()
    if #spawned >= MAX_FRUITS then return end

    local fruitTypes = {}
    for k,_ in pairs(FruitModule.Fruits) do table.insert(fruitTypes, k) end
    local pick = fruitTypes[math.random(1,#fruitTypes)]
    local model = createFruitModel(pick)

    local cf = getSpawnCFrame()
    model.PrimaryPart = model:WaitForChild("FruitPart")
    model:SetPrimaryPartCFrame(cf)
    model.Parent = Workspace

    -- Touch detection
    local touchedConn
    touchedConn = model.PrimaryPart.Touched:Connect(function(hit)
        local character = hit:FindFirstAncestorOfClass("Model")
        if not character then return end
        local player = Players:GetPlayerFromCharacter(character)
        if not player then return end

        -- Give fruit to player (fire remote event to client & server record)
        FruitRemote:FireClient(player, "Picked", {
            FruitType = pick,
            FruitName = FruitModule.Fruits[pick].Name,
            Duration = FruitModule.Fruits[pick].Duration,
            Cooldown = FruitModule.Fruits[pick].Cooldown,
        })

        -- cleanup
        if touchedConn then touchedConn:Disconnect() end
        model:Destroy()
        for i,v in ipairs(spawned) do
            if v == model then table.remove(spawned, i) break end
        end
    end)

    table.insert(spawned, model)
end

-- Periodic spawner
spawn(function()
    while true do
        spawnFruit()
        wait(SPAWN_INTERVAL)
    end
end)

-- Optional: cleanup if map resets
game:BindToClose(function()
    for _,m in ipairs(spawned) do
        if m and m.Parent then m:Destroy() end
    end
end)

-- Example server-side handling for ability effects (simple)
FruitRemote.OnServerEvent:Connect(function(player, action, data)
    if action == "UseAbility" then
        local fruitType = data.FruitType
        -- Here implement server-validated ability effects (damage, physics, etc)
        -- Example: create a hitbox in front of player for Flame
        local char = player.Character
        if not char then return end
        if fruitType == "Flame" then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local hitPart = Instance.new("Part")
            hitPart.Size = Vector3.new(4,4,4)
            hitPart.CanCollide = false
            hitPart.Anchored = true
            hitPart.CFrame = hrp.CFrame * CFrame.new(0,0,-6)
            hitPart.Parent = workspace
            -- simple damage on touch
            local conn
            conn = hitPart.Touched:Connect(function(h)
                local otherChar = h:FindFirstAncestorOfClass("Model")
                local pl = Players:GetPlayerFromCharacter(otherChar)
                if pl and pl ~= player then
                    local hum = otherChar:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum:TakeDamage(15)
                    end
                end
            end)
            delay(0.6, function()
                if conn then conn:Disconnect() end
                hitPart:Destroy()
            end)
        elseif fruitType == "Wave" then
            -- simple wave: apply force to nearby humanoids
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for _,obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Parent and obj.Parent:FindFirstChildOfClass("Humanoid") then
                    local hroot = obj.Parent:FindFirstChild("HumanoidRootPart")
                    if hroot then
                        local dist = (hroot.Position - hrp.Position).Magnitude
                        if dist <= 12 and obj.Parent ~= player.Character then
                            local bodyVel = Instance.new("BodyVelocity")
                            bodyVel.MaxForce = Vector3.new(1e5,1e5,1e5)
                            local dir = (hroot.Position - hrp.Position).Unit + Vector3.new(0,0.2,0)
                            bodyVel.Velocity = dir * 60
                            bodyVel.Parent = hroot
                            game.Debris:AddItem(bodyVel, 0.35)
                        end
                    end
                end
            end
        end
    end
end)
