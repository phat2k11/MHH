label.Size = UDim2.new(1, -10, 0, 28)
label.Position = UDim2.new(0,5,0,5)
label.BackgroundTransparency = 1
label.Text = "No Fruit"
label.TextScaled = true
label.TextColor3 = Color3.fromRGB(255,255,255)

local useBtn = Instance.new("TextButton", frame)
useBtn.Size = UDim2.new(1, -10, 0, 36)
useBtn.Position = UDim2.new(0,5,0,40)
useBtn.Text = "Use"
useBtn.TextScaled = true
useBtn.AutoButtonColor = true

local currentFruit = nil
local onCooldown = false

-- Receive pickup from server
FruitRemote.OnClientEvent:Connect(function(action, data)
    if action == "Picked" then
        currentFruit = data
        label.Text = ("Fruit: %s\nCD: %ds"):format(data.FruitType, data.Cooldown)
        useBtn.Text = "Use"
    end
end)

-- Use button
useBtn.MouseButton1Click:Connect(function()
    if not currentFruit then return end
    if onCooldown then return end

    -- visual local effects (client-side)
    -- e.g., play animation or particle (omitted for brevity)

    -- inform server to apply ability (server must validate)
    FruitRemote:FireServer("UseAbility", {FruitType = currentFruit.FruitType})

    -- start cooldown locally
    onCooldown = true
    local cd = currentFruit.Cooldown or 5
    useBtn.Text = ("Cooldown: %d"):format(cd)
    spawn(function()
        while cd > 0 do
            wait(1)
            cd = cd - 1
            useBtn.Text = ("Cooldown: %d"):format(cd)
        end
        onCooldown = false
        useBtn.Text = "Use"
    end)
end)

-- Optional: clear fruit on death
Player.CharacterAdded:Connect(function()
    currentFruit = nil
    label.Text = "No Fruit"
    useBtn.Text = "Use"
    onCooldown = false
end)
